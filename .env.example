# Copiar a .env (no versionar) y ajustar. Si una variable está aquí tiene prioridad sobre
# la del sistema operativo; si no está, se usa la del sistema operativo.

# Base de datos MySQL (DB_USER es obligatorio)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=servicio_web
DB_USER=hugo
DB_PASSWORD=

# Opcionales
# JAVA_HOME=/ruta/a/un/jdk8      # por defecto se usa ./jdk8 (instalado por setup.sh)
# CATALINA_HOME=/ruta/a/tomcat   # por defecto ./tomcat

# HTTPS (scripts/certificado.sh)
# HTTPS_PUERTO=8443              # puerto del conector HTTPS de Tomcat (≥ 1024)
# CERT_CORREO=admin@midominio.com  # correo para avisos de Let's Encrypt

# Cliente (frontend): host del servicio REST (la ruta /servicio/rest/ws es fija). Se incrusta al
# compilar (build.sh / dev.sh front), así que hay que recompilar el cliente al cambiarlo.
# Por omisión: el mismo origen que sirve el cliente. Si es otro origen, el backend debe permitir CORS.
# VITE_HOST_SERVICIO=http://mi-servidor:8080
