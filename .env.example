# Copiar a .env (no versionar) y ajustar. Si una variable está aquí tiene prioridad sobre
# la del sistema operativo; si no está, se usa la del sistema operativo.

# Base de datos MySQL (DB_USER es obligatorio)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=servicio_web
DB_USER=hugo
DB_PASSWORD=

# Opcionales
# JAVA_HOME=/ruta/a/un/jdk8      # por defecto se usa ./jdk8 (instalado por setup.sh)
# CATALINA_HOME=/ruta/a/tomcat   # por defecto ./tomcat
